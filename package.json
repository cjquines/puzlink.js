{
  "name": "puzlink",
  "version": "0.2.0",
  "description": "Tool to find patterns among sets of words",
  "keywords": [
    "puzzles"
  ],
  "homepage": "https://github.com/cjquines/puzlink.js#readme",
  "bugs": {
    "url": "https://github.com/cjquines/puzlink.js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjquines/puzlink.js.git"
  },
  "license": "MIT",
  "author": "CJ Quines <cj@cjquines.com>",
  "type": "module",
  "imports": {
    "#download": {
      "puzlink-source": {
        "node": "./src/download.node.ts",
        "default": "./src/download.ts"
      },
      "node": "./dist/download.node.js",
      "default": "./dist/download.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./parse": "./dist/parse.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!src/**/*.test.ts",
    "!src/data/hypernyms/*.txt"
  ],
  "scripts": {
    "build:cache": "tsx --conditions=puzlink-source scripts/buildCache.ts",
    "build:categories": "tsx --conditions=puzlink-source scripts/buildCategories.ts",
    "build:hypernyms": "tsx --conditions=puzlink-source scripts/buildHypernyms.ts",
    "build:tsc": "tsc --build tsconfig.build.json && node -e \"fs.cpSync('src/data/hypernyms', 'dist/data/hypernyms', { recursive: true })\"",
    "format": "prettier --write .",
    "lint": "eslint",
    "test": "vitest run",
    "test:evals": "tsx --conditions=puzlink-source scripts/runEvals.ts",
    "test:slow": "SLOW_TESTS=true vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --build tsconfig.json"
  },
  "dependencies": {
    "cromulence": "^0.6.3",
    "simple-statistics": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "chalk": "^6.0.1",
    "chokidar": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "gzip-size": "^7.0.0",
    "iso-3166": "^4.4.0",
    "meow": "^14.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
